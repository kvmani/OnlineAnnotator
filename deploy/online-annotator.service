# Example systemd unit for a standalone installation (system scope).
# Inside the ml_server suite the unit is generated by ml_server_deploy instead.
#
#   sudo cp deploy/online-annotator.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now online-annotator
[Unit]
Description=Online Annotator (semantic-segmentation ground truth)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=annotator
Group=annotator
WorkingDirectory=/opt/online-annotator/current
EnvironmentFile=/etc/online-annotator/online-annotator.env
Environment=PYTHONPATH=/opt/online-annotator/current/src
ExecStart=/opt/online-annotator/venv/bin/python -m online_annotator serve
Restart=on-failure
RestartSec=5
# Hardening: the service only needs to write its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/online-annotator

[Install]
WantedBy=multi-user.target
