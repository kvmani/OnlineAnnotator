# Environment for the Online Annotator service. Copy to /etc/online-annotator/online-annotator.env
# (mode 600). Every key of config.example.yml can be set as ONLINE_ANNOTATOR_<KEY>;
# nested keys use a double underscore, lists are JSON.
ONLINE_ANNOTATOR_HOST=0.0.0.0
ONLINE_ANNOTATOR_PORT=5070
ONLINE_ANNOTATOR_DATA_DIR=/var/lib/online-annotator
ONLINE_ANNOTATOR_SITE_NAME=Online Annotator
# Link back to the tools portal (shown as "All tools" in the top bar). A value starting
# with ":" means "the host the user typed, this port", e.g. :5000/
ONLINE_ANNOTATOR_PORTAL_URL=http://tools.intranet.local:5000/
# Central feedback page of the portal (optional).
# ONLINE_ANNOTATOR_FEEDBACK_URL=http://tools.intranet.local:5000/#feedback
# First administrator, used only when the user table is empty. Remove after first start.
# ONLINE_ANNOTATOR_ADMIN_EMAIL=lead.scientist@lab.example
# ONLINE_ANNOTATOR_ADMIN_PASSWORD=choose-a-long-one-9
# Optional internal SMTP relay for one-time sign-in codes.
# ONLINE_ANNOTATOR_EMAIL__ENABLED=true
# ONLINE_ANNOTATOR_EMAIL__SMTP_HOST=mail.intranet.local
# ONLINE_ANNOTATOR_EMAIL__FROM_ADDRESS=online-annotator@lab.example
# Set to true only when the site is served over HTTPS.
ONLINE_ANNOTATOR_COOKIE_SECURE=false
